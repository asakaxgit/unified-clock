{
  "name": "unified-clock",
  "version": "0.1.0",
  "description": "Injectable clock for Node.js: system, fixed, or adjustable time. A port of quarkus-clock.",
  "license": "Apache-2.0",
  "author": "Atsushi Sakashita <ats@saks.industries>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asakaxgit/unified-clock.git"
  },
  "homepage": "https://github.com/asakaxgit/unified-clock#readme",
  "bugs": {
    "url": "https://github.com/asakaxgit/unified-clock/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.18.12",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
